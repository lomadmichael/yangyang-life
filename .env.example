# Supabase (값은 .env.local 에 — 커밋 금지)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 secret 키 (쓰기·관리자). 브라우저로 절대 노출 금지
SUPABASE_SERVICE_ROLE_KEY=
# 1 이면 샘플 데이터(is_sample=true)도 보여 줌. 운영에서는 비워 둔다
YL_SHOW_SAMPLES=
# 관리 화면 세션 서명 키 (32바이트 이상 난수, 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
YL_SESSION_SECRET=
# 개인 코드 해시 pepper (32바이트 이상 난수). 바꾸면 모든 코드를 다시 발급해야 함
YL_CODE_PEPPER=
# 「Ai 번역 초안」 버튼용. 비워 두면 버튼이 숨겨짐
ANTHROPIC_API_KEY=
