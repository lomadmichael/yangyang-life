# Supabase (값은 .env.local 에 — 커밋 금지)
# scripts/*.mjs 는 Node 22.18 이상 필요 (.ts 파일을 타입 제거로 바로 불러옴)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 secret 키 (쓰기·관리자). 브라우저로 절대 노출 금지
SUPABASE_SERVICE_ROLE_KEY=
# 1 이면 샘플 데이터(is_sample=true)도 보여 줌.
# 로컬(.env.local)과 Vercel 「Preview」 환경에만 1. Vercel 「Production」에는 절대 넣지 않는다(비워 둠)
YL_SHOW_SAMPLES=
# ⚠ 아래 두 값(YL_SESSION_SECRET·YL_CODE_PEPPER)은 로컬 .env.local 과 Vercel 환경변수가 반드시 같은 값이어야 한다.
#   scripts/issue-code.mjs 는 로컬 pepper 로 코드를 해시하고, 운영 로그인은 Vercel pepper 로 해시한다 → 다르면 로그인 실패.
# 관리 화면 세션 서명 키 (32자 이상 난수, 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
YL_SESSION_SECRET=
# 개인 코드 해시 pepper (32자 이상 난수). 바꾸면 모든 코드를 다시 발급해야 함
YL_CODE_PEPPER=
# 「Ai 번역 초안」 버튼용. 비워 두면 버튼이 숨겨짐
ANTHROPIC_API_KEY=
